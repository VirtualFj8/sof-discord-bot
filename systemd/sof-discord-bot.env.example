# Place at /etc/default/sof-discord-bot and adjust values
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_2=
SOF_BOT_LOG=INFO
# sof-export-fire socket server (runs separately; see sof-export-fire/)
SOF_EXPORT_FIRE_HOST=127.0.0.1
SOF_EXPORT_FIRE_PORT=8765
# If you need to override SOF root discovery, you can export PWD before starting service or modify the WorkingDirectory
